{
  "name": "studyconnect-frontend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "test:cypress": "cypress run",
    "test:cypress:open": "cypress open",
    "test:cypress:ui": "cypress run --spec 'cypress/e2e/ui/**/*.cy.ts'",
    "test:cypress:e2e": "cypress run --spec 'cypress/e2e/e2e/**/*.cy.ts'",
    "test:cypress:headless": "xvfb-run -a cypress run",
    "test:cypress:ui:headless": "xvfb-run -a cypress run --spec 'cypress/e2e/ui/**/*.cy.ts'",
    "test:cypress:e2e:headless": "xvfb-run -a cypress run --spec 'cypress/e2e/e2e/**/*.cy.ts'",
    "test:selenium": "node selenium/run-tests.js"
  },
  "dependencies": {
    "@vueuse/core": "^10.9.0",
    "axios": "^1.6.7",
    "date-fns": "^3.3.1",
    "pinia": "^2.1.7",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/tsconfig": "^0.5.1",
    "cypress": "^13.7.0",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.22.0",
    "typescript": "~5.4.0",
    "vite": "^5.1.4",
    "vue-tsc": "^2.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
